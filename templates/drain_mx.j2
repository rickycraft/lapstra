insert routing-instances {{ session.vrf_name }} protocols bgp group l3rtr neighbor {{ session.dest_ip }} import Drain
insert routing-instances {{ session.vrf_name }} protocols bgp group l3rtr neighbor {{ session.dest_ip }} export Drain
{% endfor %}

